# Copy to .env for local development. Never commit .env.
# Application role: RLS enforced, cannot bypass (deploy/dev/init.sql creates it).
DATABASE_URL=postgres://rocky_app_dev:rocky-dev-only@127.0.0.1:54329/rocky
# Table owner: runs migrations (`pnpm db:migrate`). Never used by the server or worker.
DATABASE_ADMIN_URL=postgres://rocky:rocky-dev-only@127.0.0.1:54329/rocky
HOST=127.0.0.1
PORT=4310
LOG_LEVEL=info
# Local key-encryption keys for envelope encryption (ADR-0006): `id=<base64 32 bytes>` entries,
# comma-separated. `pnpm dev` generates a dev key into .env on first run. Rotation: add the new
# key, set ROCKY_KEK_CURRENT to its id, re-wrap, then remove the old one.
# ROCKY_KEK_KEYS=dev=<generated>
# ROCKY_KEK_CURRENT=dev
# GitHub webhook secret (P3-2, ADR 0007): at least 32 characters, e.g. `openssl rand -hex 32`.
# Required in production (NODE_ENV=production, or FLY_APP_NAME set on Fly.io): the server
# refuses to boot without it; unset in
# development disables POST /webhooks/github.
# GITHUB_WEBHOOK_SECRET=
# Webhook inbox retention / dedup window in days (default 30, minimum 7), applied by db:migrate.
# RETENTION_WEBHOOK_DELIVERIES_DAYS=30
# GitHub App manifest setup (P3-1, ADR 0008; runbook docs/runbooks/h3-create-github-app.md).
# `true` opens one-time setup routes (printed URL in the terminal); refused in production and
# ignored once GITHUB_APP_ID is set or the credentials file exists. Remove after creating the app.
# GITHUB_APP_SETUP=true
# https URL GitHub delivers webhooks to (local dev: a smee.io channel). Defaults to
# <ROCKY_PUBLIC_URL>/webhooks/github when ROCKY_PUBLIC_URL is https.
# GITHUB_APP_WEBHOOK_URL=https://smee.io/<channel>
# Where Rocky is reached (https, or http on 127.0.0.1/localhost). Default http://HOST:PORT.
# ROCKY_PUBLIC_URL=http://127.0.0.1:4310
# GITHUB_APP_NAME=Rocky Reviews
# The app's homepage on GitHub (https; default ROCKY_PUBLIC_URL), e.g. the repository URL.
# GITHUB_APP_HOMEPAGE_URL=
# Absolute path, written once with mode 0600 (default ~/.rocky/github-app.env).
# GITHUB_APP_CREDENTIALS_FILE=
# GitHub Enterprise Server (https only): GITHUB_URL=https://ghe.example.com (API defaults to /api/v3)
# GITHUB_URL=
# GITHUB_API_URL=
# App credentials (from the credentials file; keep the real values in a secret manager):
# GITHUB_APP_ID=
# GITHUB_APP_SLUG=
# GITHUB_APP_CLIENT_ID=
# GITHUB_APP_CLIENT_SECRET=
# GITHUB_APP_PRIVATE_KEY=   (the PEM, multi-line, inside single quotes, as the credentials file has it)
