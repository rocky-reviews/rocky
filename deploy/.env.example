# Compose-level settings for deploy/docker-compose.yml (P10-1, ADR 0043). Copy to deploy/.env
# (gitignored); the application's own configuration goes in deploy/rocky.env (see
# deploy/rocky.env.example). Passwords: `openssl rand -hex 24`. Every password is 16-256
# characters from A-Z a-z 0-9 . _ ~ - only (they go into URLs unescaped; compose interpolates
# `$` in this file, so it is refused). Compose refuses to start while one is missing.

# Postgres bootstrap superuser. Used by the init script on the first start and by the
# container's healthcheck; no Rocky process logs in with it.
POSTGRES_PASSWORD=
# The migrator (`rocky`): owns the schema, runs migrations, creates the two logins below. Set on
# the first start by deploy/postgres-init.sh; change it later with ALTER ROLE and here.
ROCKY_DB_MIGRATOR_PASSWORD=
# The server's login (rocky_app_user) and the worker's (rocky_worker_user), created or updated
# by the migration step on every start: changing a value here rotates the password.
ROCKY_DB_APP_PASSWORD=
ROCKY_DB_WORKER_PASSWORD=

# Where the server is published. 127.0.0.1 by default: put a TLS-terminating reverse proxy in
# front (ROCKY_PUBLIC_URL must be https) and set ROCKY_TRUST_PROXY in rocky.env for it. Set
# ROCKY_BIND=0.0.0.0 only on purpose.
# ROCKY_BIND=127.0.0.1
# ROCKY_PORT=4310

# The application env file the server and the worker read (default ./rocky.env next to the
# compose file).
# ROCKY_ENV_FILE=./rocky.env

# Which images to run: <prefix>-server, <prefix>-worker, <prefix>-migrate at <tag>. The defaults
# are the locally built ones (`docker compose ... up --build` or `pnpm images:build`); once
# images are published, point the prefix at the registry (e.g. ghcr.io/<owner>/rocky).
# ROCKY_IMAGE_PREFIX=rocky
# ROCKY_IMAGE_TAG=local

# Retention periods, applied by the migration step (see .env.example at the repository root
# for the meaning and minimums). Empty means the default.
# RETENTION_WEBHOOK_DELIVERIES_DAYS=30
# RETENTION_LLM_USAGE_DAYS=730
# RETENTION_MEMORY_DECAY_DAYS=90
# RETENTION_MEMORY_UNUSED_DAYS=365
# RETENTION_MEMORY_SUPERSEDED_DAYS=180
# ORG_DELETION_GRACE_DAYS=
