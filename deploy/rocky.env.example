# The application's configuration for deploy/docker-compose.yml (P10-1, ADR 0043): read by the
# server and the worker containers only. Copy to deploy/rocky.env (gitignored). Every variable
# is documented in .env.example at the repository root; this file lists what a production
# deployment needs (the images run with NODE_ENV=production, so a missing one refuses to boot).
# The database URLs and NODE_ENV=production are set by the compose file (from deploy/.env) after
# this file is read, so they cannot be changed or switched off here.

# Where Rocky is reached by browsers and by GitHub: https, behind your reverse proxy.
ROCKY_PUBLIC_URL=https://rocky.example.com
# Which client address the rate limits count (ADR 0025): none when the proxy is not trusted,
# xff:<hops> for a proxy chain in front (the n-th X-Forwarded-For entry from the right; only
# safe when the server accepts traffic from the proxy alone).
ROCKY_TRUST_PROXY=none
LOG_LEVEL=info

# The GitHub App (docs/runbooks/h3-create-github-app.md): id, client id and secret, webhook
# secret (at least 32 characters), and the private key. The PEM goes in double quotes on one
# line with \n for each line break (`awk '{ printf "%s\\n", $0 }' app.pem`), as the credentials
# file shows it; GitHub Enterprise Server adds GITHUB_URL=https://ghe.example.com.
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_WEBHOOK_SECRET=
GITHUB_APP_PRIVATE_KEY=""

# Login cookie and CSRF key (`openssl rand -hex 32`).
ROCKY_SESSION_SECRET=
# Key-encryption keys for envelope encryption (ADR 0006): `id=<base64 of 32 random bytes>`
# (`openssl rand -base64 32`), comma-separated for rotation; ROCKY_KEK_CURRENT names the one to
# encrypt with.
ROCKY_KEK_KEYS=prod=
ROCKY_KEK_CURRENT=prod

# LLM roles (ADR 0012). Nothing set: every role on the Anthropic API with the default models,
# using the key below. Other providers, models and efforts: ROCKY_LLM_* in .env.example.
ANTHROPIC_API_KEY=
# Automatic analysis of every new pull request head (off: nothing is analysed or spent until a
# reviewer asks), and the per-PR token limit.
# ROCKY_ANALYSIS_AUTO=on
# ROCKY_ANALYSIS_TOKEN_LIMIT=150000
# Embeddings and the repository index (ADR 0040), off until set.
# ROCKY_LLM_EMBED_PROVIDER=openai
# OPENAI_API_KEY=
# ROCKY_INDEX_AUTO=on
