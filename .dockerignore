# Build context for deploy/Dockerfile (P10-1, ADR 0043 S3). Secrets, local state and anything
# the build does not need stay out, so they can never land in a layer or a build log.
.git
.github
.claude
node_modules
**/node_modules
dist
**/dist
coverage
artifacts
test-results
playwright-report
.env
.env.*
**/*.env
**/*.pem
**/*.key
**/github-app.env
design-poc
docs
**/*.md
.DS_Store
*.log
*.tsbuildinfo
packages/evals/reports
