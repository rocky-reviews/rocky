{
  "name": "rocky",
  "version": "0.0.0",
  "private": true,
  "description": "Rocky Reviews: code review where AI does the reading and a human makes the call.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "packageManager": "pnpm@10.34.8",
  "engines": {
    "node": ">=24.11.0"
  },
  "scripts": {
    "dev": "node scripts/ensure-env.mjs && docker compose -f docker-compose.dev.yml up -d --wait && pnpm db:migrate && pnpm --parallel --filter \"./apps/*\" dev",
    "dev:down": "docker compose -f docker-compose.dev.yml down",
    "seed": "node scripts/ensure-env.mjs && tsx --env-file=.env scripts/seed.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p apps/web/tsconfig.json && tsc --noEmit -p apps/web/e2e/tsconfig.json",
    "lint": "eslint . --max-warnings=0 && node scripts/check-no-raw-colors.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test -c apps/web/playwright.config.ts",
    "verify": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test:coverage",
    "design:poc-screenshots": "tsx scripts/screenshot-poc.ts",
    "prepare": "simple-git-hooks",
    "security:scan": "scripts/security/gitleaks.sh && scripts/security/osv-scan.sh && scripts/security/semgrep.sh && scripts/security/actionlint.sh",
    "schema:emit": "tsx packages/schema/scripts/emit.ts",
    "schema:fixtures": "tsx packages/schema/scripts/generate-large-fixture.ts",
    "db:migrate": "node scripts/ensure-env.mjs && tsx --env-file=.env scripts/migrate.ts",
    "evals": "tsx scripts/evals.ts",
    "mirror:rebuild": "node scripts/ensure-env.mjs && pnpm --filter @rocky-reviews/worker mirror:rebuild",
    "rocky": "tsx --env-file-if-exists=.env apps/worker/src/rocky.ts"
  },
  "simple-git-hooks": {
    "pre-commit": "sh scripts/precommit.sh"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@rocky-reviews/db": "workspace:*",
    "@rocky-reviews/evals": "workspace:*",
    "@rocky-reviews/llm": "workspace:*",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.13.0",
    "pg": "8.23.1",
    "prettier": "3.9.10",
    "simple-git-hooks": "2.14.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vitest": "5.0.5"
  }
}
